{
  "dependencies": {
    "chokidar": "^4.0.3",
    "mermaid": "^10.8.0",
    "neo4j-driver": "^5.28.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.1.4",
    "prettier": "^3.5.3",
    "typescript": "5.8.3",
    "vite-node": "^3.1.4"
  },
  "name": "neo4j-diagram-app",
  "packageManager": "yarn@4.9.1",
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "printWidth": 80,
    "tabWidth": 2,
    "bracketSpacing": true,
    "arrowParens": "always"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "slogs:import": "vite-node scripts/slog-to-neo4j.ts scripts/a3p.slog",
    "slogs:import-static": "vite-node scripts/slog-to-neo4j.ts scripts/slogs.json",
    "start": "next start",
    "start:chain": "bash scripts/init.sh && docker compose up -d"
  },
  "type": "module",
  "version": "0.1.0"
}
