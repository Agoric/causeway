{
  "name": "neo4j-visualization",
  "version": "1.0.0",
  "description": "Neo4j visualization and API for Agoric slog events",
  "type": "module",
  "bin": {
    "slog2neo4j": "./tools/slog2neo4j.js"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd neo4j-diagram-app && npm start",
    "build": "cd neo4j-diagram-app && npm run build",
    "install-client": "cd neo4j-diagram-app && npm install",
    "install-all": "npm install && npm run install-client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^5.6.0",
    "zx": "^7.2.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}

